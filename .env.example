# Copy to .env and fill locally. Never commit real tokens.
VULTR_API_KEY=
RUNPOD_TOKEN=
HF_TOKEN=

# Replit UI gateway only: public GPU API origin, not an API key.
# Set this in Replit deployment Secrets; do not copy this entire .env to Replit.
SAFESC_BACKEND_ORIGIN=https://YOUR-POD-ID-8000.proxy.runpod.net

# Public HTTPS origin used in phone pairing QR codes. No trailing slash.
PUBLIC_URL=http://localhost:8000
# Leave blank to create a random owner-only token at data/app_token.
APP_TOKEN=
STREAMING_MODEL=moss
MOSS_WS_URL=ws://127.0.0.1:8001/v1/realtime
# JSON argv; example in docs/overview/models.md. Managed service exits before heavy jobs.
MOSS_SERVICE_COMMAND=
MODEL_REVISION=unconfigured
OBSERVATION_VERIFIER_MODEL=none
VERIFIER_CHECKPOINT=
VERIFIER_ADAPTER=
VERIFIER_RESEARCH_MODE=false
VERIFICATION_INTERVAL_SECONDS=4
VERIFICATION_FRAME_COUNT=4
MAX_INFERENCE_LAG_SECONDS=60
ALERT_AGREEMENT_SECONDS=12
ENHANCEMENT_MODEL=bypass
FASTLLVE_CHECKPOINT=
ENABLE_TRACKING=false
# Experimental only: the installed MOSS NF4 model did not pass spatial JSON validation.
MOSS_SPATIAL_OUTPUT=false
ENABLE_RELAY_VSR=false
RELAY_MAX_INPUT_DIMENSION=480
ENABLE_RELIFT=false
ENABLE_BVIMAMBA=false
ENABLE_CLIP_REVIEW=false
RELIFT_PYTHON=
RELIFT_FRAME_LIMIT=84
ALLOW_RTSP=false
PRE_EVENT_SECONDS=10
POST_EVENT_SECONDS=10
OBJECT_POST_EVENT_SECONDS=30
SAMPLE_FPS=2
CAPTURE_FPS=12
ALERT_CONFIDENCE_THRESHOLD=0.75
ALERT_COOLDOWN_SECONDS=20
RETENTION_HOURS=24
DATA_DIR=data
# Detector cascade: STREAMING_MODEL=cascade runs YOLO11n + ByteTrack + rules on every sampled frame,
# pose only on flagged tracks, and the Qwen verifier (if OBSERVATION_VERIFIER_MODEL=qwen3vl) only on rule candidates.
DETECTOR_WEIGHTS=yolo11n.pt
CASCADE_POSE=true
POSE_WEIGHTS=yolo11n-pose.pt
PERSON_DOWN_SECONDS=10
RACK_DWELL_SECONDS=45
# JSON list of polygons in 0..1 frame units, e.g. [[[0.1,0.5],[0.5,0.5],[0.5,0.9],[0.1,0.9]]]
RACK_ZONES=
CASCADE_COOLDOWN_SECONDS=30

# AI dispatch agent (apps/api/dispatch_agent.py). Without a key the dashboard shows a rules-based plan.
ANTHROPIC_API_KEY=
DISPATCH_AGENT_MODEL=claude-opus-5-5

# Backend only. Never copy these credentials to Replit or use VITE_ prefixes.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=safesc-incidents
# Managed bucket cap below Supabase Free's 1 GB allowance; oldest media evicted first.
ARCHIVE_MAX_MB=800
